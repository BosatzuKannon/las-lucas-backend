generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// --- ENUMS ---
enum UserStatus {
  ACTIVE
  BANNED
  INACTIVE
}

enum TransactionType {
  RECHARGE
  WITHDRAWAL
  ENTRY_FEE
  PRIZE
  LIFE_PURCHASE
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum TournamentType {
  DAILY
  WEEKLY
  BIWEEKLY
  CUSTOM_DATE
}

enum RoomStatus {
  SCHEDULED
  WAITING
  VOTING
  ACTIVE
  FINISHED
  CANCELLED
}

enum SeasonStatus {
  ACTIVE
  FINISHED
}

// --- MODELS ---
model User {
  id                     String     @id @default(uuid())
  googleId               String     @unique @map("google_id")
  email                  String     @unique
  name                   String
  avatarUrl              String?    @map("avatar_url")
  status                 UserStatus @default(ACTIVE)
  balanceLucas           Float      @default(0) @map("balance_lucas")
  globalPoints           Int        @default(0) @map("global_points")
  isPro                  Boolean    @default(false) @map("is_pro")
  isVerified             Boolean    @default(false) @map("is_verified")
  phone                  String?
  identificationDocument String?    @map("identification_document")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  // Relations
  device             Device?
  preference         UserPreference?
  transactions       Transaction[]
  roomParticipations RoomParticipant[]
  seasonWins         SeasonWinner[]

  @@map("users")
}

model Device {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  pushToken  String?  @map("push_token")
  deviceInfo Json?    @map("device_info")
  lastLogin  DateTime @default(now()) @map("last_login")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("devices")
}

model UserPreference {
  id                 String  @id @default(uuid())
  userId             String  @unique @map("user_id")
  emailNotifications Boolean @default(true) @map("email_notifications")
  pushNotifications  Boolean @default(true) @map("push_notifications")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Transaction {
  id                    String            @id @default(uuid())
  userId                String            @map("user_id")
  amount                Float
  transactionType       TransactionType   @map("transaction_type")
  status                TransactionStatus @default(PENDING)
  reference             String?           @unique
  externalTransactionId String?           @unique @map("external_transaction_id")
  paymentMethodType     String?           @map("payment_method_type")
  paymentMethodExtra    Json?             @map("payment_method_extra")
  createdAt             DateTime          @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("transactions")
}

model Room {
  id                       String         @id @default(uuid())
  tournamentType           TournamentType @map("tournament_type")
  status                   RoomStatus     @default(SCHEDULED)
  selectedCategoryId       String?        @map("selected_category_id")
  entryFee                 Float          @map("entry_fee")
  extraLifeFee             Float          @map("extra_life_fee")
  prizePool                Float          @map("prize_pool")
  startTime                DateTime       @map("start_time")
  maxPlayers               Int            @map("max_players")
  currentPlayers           Int            @default(0) @map("current_players")
  normalQuestionCount      Int            @map("normal_question_count")
  normalQuestionDuration   Int            @default(7) @map("normal_question_duration")
  survivalQuestionDuration Int            @default(4) @map("survival_question_duration")

  // Deadlines de fase (mensurables, calculados). `startTime` ES INMUTABLE:
  // solo se trabaja con estos campos + aritmética de fechas.
  waitingClosesAt DateTime? @map("waiting_closes_at")
  votingClosesAt  DateTime? @map("voting_closes_at")
  // Avance de preguntas persistido (sobrevive reinicios del servidor).
  questionCursor  Int       @default(0) @map("question_cursor")
  survivalMode    Boolean   @default(false) @map("survival_mode")

  createdAt DateTime @default(now()) @map("created_at")

  participants RoomParticipant[]

  @@map("rooms")
}

model Category {
  id       String  @id @default(uuid())
  name     String  @unique
  isActive Boolean @default(true) @map("is_active")

  questions Question[]

  @@map("categories")
}

model Question {
  id            String @id @default(uuid())
  categoryId    String @map("category_id")
  text          String
  correctAnswer String @map("correct_answer")
  options       Json
  difficulty    Int    @default(1)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@map("questions")
}

model RoomParticipant {
  roomId                String  @map("room_id")
  userId                String  @map("user_id")
  score                 Int     @default(0)
  hasPurchasedExtraLife Boolean @default(false) @map("has_purchased_extra_life")
  isEliminated          Boolean @default(false) @map("is_eliminated")

  // Resultado final de la sala (se rellena únicamente en la liquidación).
  // `position` usa ranking de competición (empates comparten posición): todos
  // los ganadores son posición 1. Permanece null mientras la sala no se liquida.
  position             Int?  @map("position")
  // Porción del pozo ganada en esta sala. 0 para los no premiados.
  prizeWon             Float @default(0) @map("prize_won")
  // Ronda (1-based) en la que el jugador fue eliminado. Permite reconstruir
  // las posiciones tras un reinicio del servidor. null si nunca fue eliminado.
  eliminatedAtQuestion Int?  @map("eliminated_at_question")

  // Votación de categoría en vivo (fase VOTING).
  votedCategoryId String?   @map("voted_category_id")
  votedAt         DateTime? @map("voted_at")

  // Snapshot de presentación tomado al momento de la inscripción.
  // Permite que el canal Realtime de room_participants sea autosuficiente
  // (el cliente no necesita re-consultar el backend para renderizar el chip).
  userName      String  @map("user_name")
  userAvatarUrl String? @map("user_avatar_url")

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@map("room_participants")
}

model SystemConfig {
  id                 String  @id @default(uuid())
  minAppVersion      String  @map("min_app_version")
  latestAppVersion   String  @map("latest_app_version")
  maintenanceMode    Boolean @default(false) @map("maintenance_mode")
  maintenanceMessage String? @map("maintenance_message")

  @@map("system_configs")
}

// --- TEMPORADAS (Ranking global de puntos) ---
model Season {
  id               String       @id @default(uuid())
  startDate        DateTime     @map("start_date")
  endDate          DateTime     @map("end_date")
  firstPlacePrize  Float        @map("first_place_prize")
  secondPlacePrize Float        @map("second_place_prize")
  thirdPlacePrize  Float        @map("third_place_prize")
  status           SeasonStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  seasonWinners SeasonWinner[]

  @@map("seasons")
}

model SeasonWinner {
  id            String   @id @default(uuid())
  seasonId      String   @map("season_id")
  userId        String   @map("user_id")
  position      Int
  prizeWon      Float    @map("prize_won")
  pointsAtClose Int      @map("points_at_close")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([seasonId, position])
  @@map("season_winners")
}
